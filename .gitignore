ALLtoMD/*.docx
ALLtoMD/*.xlsx
ALLtoMD/*.csv
ALLtoMD/*.html
ALLtoMD/*.htm
ALLtoMD/*.txt
ALLtoMD/*.rtf
ALLtoMD/MDs/*
!ALLtoMD/MDs/.gitkeep
